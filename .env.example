NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://tasker:tasker@localhost:5432/tasker
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info

# App
APP_BASE_URL=http://localhost:3000

# JWT
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# Realtime / WebSocket (Phase 8). Ticket signed by this secret, TTL 60s,
# single-use (jti stored in Redis for the same TTL). Rotate to invalidate
# in-flight WS tickets without touching JWT sessions.
RT_TICKET_SECRET=change-me-to-another-random-string-of-at-least-32-chars
RT_TICKET_TTL_S=60
RT_ALLOWED_ORIGINS=http://localhost:3000

# Web Push (Phase 8). Generate with `pnpm exec web-push generate-vapid-keys`.
# Leaving them empty disables the push channel; email + in-app still work.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@tasker.dev

# Notification delivery timing (Phase 8).
NOTIF_EMAIL_BATCH_WINDOW_S=300
NOTIF_DEDUPE_WINDOW_S=60

# SMTP (Mailhog defaults for dev)
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
SMTP_FROM="Tasker" <noreply@tasker.dev>
SMTP_SECURE=false

# OAuth
OAUTH_CALLBACK_BASE_URL=http://localhost:3001
OAUTH_SUCCESS_REDIRECT_URL=http://localhost:3000/auth/oauth/callback
# Google Cloud Console → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub Settings → Developer settings → OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Frontend — URL of the API server reachable by the browser (or SSR container)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Object storage (MinIO for local dev; swap for AWS S3 or Cloudflare R2 in prod)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=tasker-attachments
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
# MinIO requires path-style URLs; set to 'false' for AWS S3 or Cloudflare R2.
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PUT_URL_TTL_S=60
STORAGE_GET_URL_TTL_S=300

# AI Actions
# Leaving ANTHROPIC_API_KEY empty disables live AI
# calls (the adapter is registered but every invocation throws) — the app
# still boots and every non-AI feature keeps working.
# Set AI_FALLBACK_PROVIDER=openai to enable single-shot fallback on transient
# provider errors; requires OPENAI_API_KEY. Bump AI_CONSENT_DOCUMENT_VERSION
# whenever the data-sharing consent text changes to force re-acceptance.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_DEFAULT_PROVIDER=anthropic
# AI_FALLBACK_PROVIDER=openai
AI_MONTHLY_TOKEN_BUDGET=1000000
AI_CONSENT_DOCUMENT_VERSION=v1
THROTTLE_AI_ACTION_LIMIT=30
THROTTLE_AI_ACTION_TTL_S=60
