NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://tasker:tasker@localhost:5432/tasker
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info

# App
APP_BASE_URL=http://localhost:3000

# JWT
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# SMTP (Mailhog defaults for dev)
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
SMTP_FROM="Tasker" <noreply@tasker.dev>
SMTP_SECURE=false

# OAuth
OAUTH_CALLBACK_BASE_URL=http://localhost:3001
OAUTH_SUCCESS_REDIRECT_URL=http://localhost:3000/auth/oauth/callback
# Google Cloud Console → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub Settings → Developer settings → OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Frontend — URL of the API server reachable by the browser (or SSR container)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Object storage (MinIO for local dev; swap for AWS S3 or Cloudflare R2 in prod)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=tasker-attachments
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
# MinIO requires path-style URLs; set to 'false' for AWS S3 or Cloudflare R2.
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PUT_URL_TTL_S=60
STORAGE_GET_URL_TTL_S=300
