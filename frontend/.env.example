# Public origin of the NestJS API as reached from the browser.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Server-side base URL for direct backend calls from RSC and Route Handlers.
# In Docker this typically differs from NEXT_PUBLIC_API_URL (e.g. http://api:3001).
INTERNAL_API_URL=http://localhost:3001

# S3-compatible storage origin the browser PUTs attachment bytes to via a
# presigned URL. Read at build time by next.config.ts and added to CSP
# `connect-src` so uploads aren't blocked. Match the backend's STORAGE_ENDPOINT.
STORAGE_ENDPOINT=http://localhost:9000

# 32+ character random string used by iron-session to encrypt the session cookie.
# Generate with: openssl rand -hex 32
SESSION_COOKIE_SECRET=replace-me-with-a-32-plus-character-random-secret

# Sentry (frontend). DSN is safe to commit — it's a public event ingest URL
# baked into the browser bundle. Leave empty to disable client-side error
# reporting entirely.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_RELEASE_ID=

# Source-map upload credentials (build-time only, CI). Never set in the
# runtime environment — SENTRY_AUTH_TOKEN gates release publishing.
# SENTRY_ORG=davi-pavone
# SENTRY_PROJECT_WEB=tasker-web
# SENTRY_AUTH_TOKEN=
