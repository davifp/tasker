#!/usr/bin/env sh
set -e

pnpm lint-staged

# Scoped typecheck: only workspaces that changed since the previous commit.
# On the very first commit HEAD^ does not exist, so fall back to checking all workspaces.
if git rev-parse --verify HEAD^ > /dev/null 2>&1; then
  pnpm turbo run typecheck --filter="...[HEAD^]"
else
  pnpm turbo run typecheck
fi
