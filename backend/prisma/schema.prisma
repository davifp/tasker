generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

enum OAuthProvider {
  GOOGLE
  GITHUB
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum AttachmentStatus {
  PENDING
  READY
  DELETING
}

enum SprintState {
  PLANNED
  ACTIVE
  COMPLETED
}

enum SprintSnapshotPhase {
  START
  COMPLETE
}

enum EpicStatus {
  PLANNED
  IN_PROGRESS
  DONE
  CANCELED
}

enum MetricJobStatus {
  RUNNING
  OK
  FAILED
}

// Notification catalog (Phase 8). Enum members are UPPER_SNAKE so they can be
// mirrored 1:1 by the Zod schema in `@tasker/config` — a value read from the
// DB is immediately valid on the wire without translation.
enum NotificationEventType {
  COMMENT_MENTION
  TASK_ASSIGNED
  COMMENT_FOLLOWED
  SPRINT_LIFECYCLE
  AI_BUDGET_THRESHOLD
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

enum NotificationSourceKind {
  TASK
  COMMENT
  SPRINT
  WORKSPACE
}

// AI Actions (Phase 9). Enum members are UPPER_SNAKE so they can be mirrored
// 1:1 by the Zod schema in `@tasker/config` (see AI_ACTION values) — a value
// read from the DB is immediately valid on the wire without translation.
enum AiAction {
  GENERATE_DESCRIPTION
  SUMMARIZE_COMMENTS
  GENERATE_CHECKLIST
  ESTIMATE_AND_SUGGEST
}

enum AiInvocationStatus {
  OK
  ERROR
  ABORTED
}

enum AiFeedbackRating {
  POSITIVE
  NEGATIVE
}

// Platform (public API). Granular scopes issued per API key so a script
// only receives the least privilege it actually needs. Enum members are
// UPPER_SNAKE with a `:`-separated logical form (`tasks:read`) mirrored 1:1
// by the Zod schema in `@tasker/config` — see PLATFORM_API_KEY_SCOPES.
enum ApiKeyScope {
  TASKS_READ
  TASKS_WRITE
  PROJECTS_READ
  PROJECTS_WRITE
  COMMENTS_READ
  COMMENTS_WRITE
  SPRINTS_READ
  SPRINTS_WRITE
  MEMBERS_READ
  WEBHOOKS_MANAGE
}

// Platform (outbound webhooks). Subset of domain events promoted to the
// public contract; adding a new event requires bumping the wire enum and
// documenting it — subscribers depend on the value name.
enum WebhookEventType {
  TASK_CREATED
  TASK_UPDATED
  TASK_DELETED
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_DELETED
  COMMENT_CREATED
  COMMENT_UPDATED
  COMMENT_DELETED
  SPRINT_CREATED
  SPRINT_UPDATED
  SPRINT_STARTED
  SPRINT_COMPLETED
}

// Platform (integrations). One row per provider available in v1.
enum IntegrationProvider {
  GITHUB
  GOOGLE_CALENDAR
}

// Platform (integrations). CONNECTED is the healthy state; upstream token
// revocation or 401/403 from a provider call flips the row to
// NEEDS_RECONNECT, which the UI surfaces as a *Reconnect* CTA.
enum IntegrationState {
  CONNECTED
  NEEDS_RECONNECT
  DISCONNECTED
}

// Platform (GitHub link). Distinguishes between issues and pull requests
// so the mirror can pick the right REST endpoint on write-back.
enum TaskExternalLinkType {
  ISSUE
  PR
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique @db.Citext
  emailVerifiedAt DateTime?
  passwordHash    String?
  displayName     String
  avatarUrl       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  oauthAccounts           OAuthAccount[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  sessions                Session[]
  workspaceMembers        WorkspaceMember[]
  ownedWorkspaces         Workspace[]                 @relation("WorkspaceOwner")
  sentInvitations         Invitation[]                @relation("InvitationSender")
  auditLogs               AuditLog[]                  @relation("AuditLogActor")
  ownedProjects           Project[]                   @relation("ProjectOwner")
  createdProjects         Project[]                   @relation("ProjectCreator")
  assignedTasks           Task[]                      @relation("TaskAssignee")
  createdTasks            Task[]                      @relation("TaskCreator")
  comments                Comment[]
  viewPreferences         UserProjectViewPreference[]
  commentMentions         CommentMention[]            @relation("MentionedUser")
  commentReactions        CommentReaction[]           @relation("CommentReactor")
  uploadedAttachments     Attachment[]                @relation("AttachmentUploader")
  activities              Activity[]                  @relation("ActivityActor")
  createdSprints          Sprint[]                    @relation("SprintCreator")
  sprintCapacities        SprintCapacity[]            @relation("SprintCapacityMember")
  createdEpics            Epic[]                      @relation("EpicCreator")
  notificationsReceived   Notification[]              @relation("NotificationRecipient")
  notificationsActed      Notification[]              @relation("NotificationActor")
  notificationPreferences NotificationPreference[]
  pushSubscriptions       PushSubscription[]
  aiConsentsAccepted      WorkspaceAiConsent[]        @relation("AiConsentAcceptor")
  aiInvocations           AiInvocation[]              @relation("AiInvocationActor")
  aiFeedbackGiven         AiFeedback[]                @relation("AiFeedbackAuthor")

  // Platform (Phase 10)
  apiKeysCreated       ApiKey[]      @relation("ApiKeyCreator")
  webhooksCreated      Webhook[]     @relation("WebhookCreator")
  integrationsCreated  Integration[] @relation("IntegrationCreator")
}

model OAuthAccount {
  id                String        @id @default(cuid())
  userId            String
  provider          OAuthProvider
  providerAccountId String
  createdAt         DateTime      @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  integrations Integration[]

  @@unique([provider, providerAccountId])
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Workspace {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  ownerUserId String
  deletedAt   DateTime?
  purgeAt     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner            User                 @relation("WorkspaceOwner", fields: [ownerUserId], references: [id])
  members          WorkspaceMember[]
  invitations      Invitation[]
  auditLogs        AuditLog[]
  projects         Project[]
  labels           Label[]
  tasks            Task[]
  comments         Comment[]
  commentMentions  CommentMention[]
  commentReactions CommentReaction[]
  attachments      Attachment[]
  activities       Activity[]
  sprints          Sprint[]
  sprintCapacities SprintCapacity[]
  sprintSnapshots  SprintTaskSnapshot[]
  epics            Epic[]
  metricJobLogs    MetricJobLog[]
  notifications    Notification[]
  aiConsent        WorkspaceAiConsent?
  aiUsage          WorkspaceAiUsage[]
  aiInvocations    AiInvocation[]
  aiFeedback       AiFeedback[]

  // Platform (Phase 10)
  apiKeys              ApiKey[]
  webhooks             Webhook[]
  integrations         Integration[]
  taskExternalLinks    TaskExternalLink[]
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole
  joinedAt    DateTime      @default(now())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Invitation {
  id              String        @id @default(cuid())
  workspaceId     String
  email           String        @db.Citext
  role            WorkspaceRole
  tokenHash       String        @unique
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitationSender", fields: [invitedByUserId], references: [id])
}

model Session {
  id          String    @id @default(cuid())
  userId      String
  refreshHash String    @unique
  deviceLabel String
  userAgent   String?
  ip          String?
  lastUsedAt  DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String?
  actorUserId String?
  event       String
  targetType  String?
  targetId    String?
  metadata    Json     @default("{}")
  traceId     String?
  createdAt   DateTime @default(now())

  // SetNull on workspace so hard-deleting a workspace (cleanup cron past
  // purgeAt) preserves the audit trail — the FK falls back to null instead
  // of blocking the delete or cascading it away.
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  actor     User?      @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, targetType, createdAt(sort: Desc)])
  @@index([event])
}

model Project {
  id              String        @id @default(cuid())
  workspaceId     String
  slug            String
  name            String
  description     String?
  color           String
  icon            String
  status          ProjectStatus @default(ACTIVE)
  ownerUserId     String
  createdByUserId String
  deletedAt       DateTime?
  purgeAt         DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  workspace       Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner           User                        @relation("ProjectOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  createdBy       User                        @relation("ProjectCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  tasks           Task[]
  sequence        ProjectSequence?
  viewPreferences UserProjectViewPreference[]
  activities      Activity[]
  sprints         Sprint[]
  epics           Epic[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, status])
}

model Label {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  color       String
  createdAt   DateTime @default(now())

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  taskLinks TaskLabel[]

  @@unique([workspaceId, name])
}

model Task {
  id              String     @id @default(cuid())
  workspaceId     String
  projectId       String
  number          Int
  title           String
  description     String     @default("")
  status          TaskStatus @default(BACKLOG)
  priority        Priority   @default(MEDIUM)
  position        String
  assigneeUserId  String?
  createdByUserId String
  startDate       DateTime?
  dueDate         DateTime?
  // Planning (Phase 6) — nullable so pre-existing tasks are unaffected.
  // `estimate` in story points contributes to burndown/velocity; null counts
  // as 0 for point sums but still counts for scope.
  estimate        Int?
  sprintId        String?
  epicId          String?
  deletedAt       DateTime?
  purgeAt         DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  workspace       Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project         Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee        User?                @relation("TaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  createdBy       User                 @relation("TaskCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  sprint          Sprint?              @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  epic            Epic?                @relation(fields: [epicId], references: [id], onDelete: SetNull)
  labels          TaskLabel[]
  dependencies    TaskDependency[]     @relation("TaskDependencies_task")
  dependents      TaskDependency[]     @relation("TaskDependencies_blocker")
  checklistItems  ChecklistItem[]
  comments        Comment[]
  attachments     Attachment[]
  activities      Activity[]
  sprintSnapshots SprintTaskSnapshot[]
  externalLinks   TaskExternalLink[]

  @@unique([projectId, number])
  @@index([workspaceId, projectId, status, position])
  @@index([workspaceId, assigneeUserId, status])
  @@index([workspaceId, projectId, startDate, dueDate])
  @@index([sprintId])
  @@index([sprintId, status])
  @@index([epicId])
}

model TaskLabel {
  taskId  String
  labelId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
}

model TaskDependency {
  taskId          String
  blockedByTaskId String

  task      Task @relation("TaskDependencies_task", fields: [taskId], references: [id], onDelete: Cascade)
  blockedBy Task @relation("TaskDependencies_blocker", fields: [blockedByTaskId], references: [id], onDelete: Cascade)

  @@id([taskId, blockedByTaskId])
  @@index([blockedByTaskId])
}

model ChecklistItem {
  id        String   @id @default(cuid())
  taskId    String
  title     String
  checked   Boolean  @default(false)
  position  String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, position])
}

model Comment {
  id           String    @id @default(cuid())
  workspaceId  String
  taskId       String
  authorUserId String
  body         String
  editedAt     DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User              @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  mentions  CommentMention[]
  reactions CommentReaction[]

  @@index([taskId, createdAt])
}

// One row per (comment, mentioned user). Persisting by userId (not handle)
// makes mentions survive display-name renames and lets removed members fail
// closed at render time (mention resolves to plain text). Offset is the byte
// offset in the comment body of the '@' character, kept so the client can
// re-derive positions without re-parsing.
model CommentMention {
  id              String   @id @default(cuid())
  workspaceId     String
  commentId       String
  mentionedUserId String
  offset          Int
  createdAt       DateTime @default(now())

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  comment       Comment   @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUser User      @relation("MentionedUser", fields: [mentionedUserId], references: [id], onDelete: Cascade)

  @@unique([commentId, mentionedUserId])
  @@index([mentionedUserId, createdAt(sort: Desc)])
  @@index([workspaceId])
}

// Idempotent add/remove — the unique triple (comment, user, emoji) blocks
// duplicates so a second POST is a no-op. Emoji is validated in application
// code against the shared ReactionsCatalog; storing as a plain string keeps
// the catalog governance out of the DB layer.
model CommentReaction {
  id          String   @id @default(cuid())
  workspaceId String
  commentId   String
  userId      String
  emoji       String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  comment   Comment   @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User      @relation("CommentReactor", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
  @@index([commentId, emoji])
  @@index([workspaceId])
}

// Attachment metadata; the bytes themselves live in object storage. Status
// tracks the two-phase upload: PENDING after signUpload(), READY after
// confirm(), DELETING while the janitor sweeps object-storage residue.
model Attachment {
  id             String           @id @default(cuid())
  workspaceId    String
  taskId         String
  uploaderUserId String
  storageKey     String           @unique
  filename       String
  mime           String
  sizeBytes      Int
  status         AttachmentStatus @default(PENDING)
  deletedAt      DateTime?
  createdAt      DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader  User      @relation("AttachmentUploader", fields: [uploaderUserId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([workspaceId])
}

// Product-facing activity feed. Distinct from AuditLog: AuditLog is retained
// for compliance and is written for every server-side write, while Activity
// carries denormalized payload snapshots and is optimized for feed reads.
// payload is a compact JSON snapshot so the feed can render a line without
// a second fetch (see techspec § Data flow).
model Activity {
  id          String   @id @default(cuid())
  workspaceId String
  projectId   String
  taskId      String?
  actorUserId String?
  verb        String
  payload     Json     @default("{}")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor     User?     @relation("ActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([taskId, createdAt(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc)])
}

model ProjectSequence {
  projectId  String @id
  nextNumber Int    @default(1)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// Planning — Sprint lifecycle. Number is auto-generated per project (unique
// (projectId, number)). PRD FR-2 caps one Active sprint per project; that
// invariant is enforced by a partial unique index in the accompanying SQL
// migration (Prisma cannot express `WHERE state='ACTIVE'` in `@@unique`).
model Sprint {
  id              String      @id @default(cuid())
  workspaceId     String
  projectId       String
  number          Int
  name            String
  goal            String?
  state           SprintState @default(PLANNED)
  startDate       DateTime
  endDate         DateTime
  startedAt       DateTime?
  completedAt     DateTime?
  createdByUserId String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  workspace  Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project    Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User                 @relation("SprintCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  tasks      Task[]
  snapshots  SprintTaskSnapshot[]
  capacities SprintCapacity[]

  @@unique([projectId, number])
  @@index([workspaceId, state])
  @@index([workspaceId, projectId, startDate])
}

// Planning — optional per-member capacity for planner over-allocation warning.
// Scoped strictly to the sprint (does not persist across sprints unless the
// planner explicitly copies it forward — see FR-15).
model SprintCapacity {
  id             String   @id @default(cuid())
  workspaceId    String
  sprintId       String
  memberUserId   String
  capacityPoints Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sprint    Sprint    @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  member    User      @relation("SprintCapacityMember", fields: [memberUserId], references: [id], onDelete: Cascade)

  @@unique([sprintId, memberUserId])
  @@index([workspaceId])
}

// Planning — immutable snapshot of a task at a sprint lifecycle boundary
// (START on activate, COMPLETE on close). Powers burndown and the close
// summary so editing the underlying Task does not drift historical metrics.
model SprintTaskSnapshot {
  id             String              @id @default(cuid())
  workspaceId    String
  sprintId       String
  taskId         String
  phase          SprintSnapshotPhase
  snapshotAt     DateTime            @default(now())
  status         TaskStatus
  estimate       Int?
  assigneeUserId String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sprint    Sprint    @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([sprintId, taskId, phase])
  @@index([sprintId, phase, snapshotAt])
  @@index([workspaceId])
}

// Planning — quarterly roadmap epic. `startQuarter`/`endQuarter` are the
// canonical `YYYY-Qn` id (see packages/config → QUARTER_ID_REGEXP). Soft
// delete leaves linked tasks intact — unlinking is not the same as archiving.
model Epic {
  id              String     @id @default(cuid())
  workspaceId     String
  projectId       String
  title           String
  description     String?
  status          EpicStatus @default(PLANNED)
  startQuarter    String
  endQuarter      String
  createdByUserId String
  deletedAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User      @relation("EpicCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  tasks     Task[]

  @@index([workspaceId, startQuarter, endQuarter])
  @@index([workspaceId, projectId, status])
}

// Planning — metrics job telemetry. Powers the dashboard `asOf` timestamp
// (last successful matview refresh) and the /health probe for the metrics
// worker. `workspaceId` nullable because the repeatable job runs globally.
model MetricJobLog {
  id          String          @id @default(cuid())
  workspaceId String?
  matview     String
  status      MetricJobStatus
  startedAt   DateTime        @default(now())
  finishedAt  DateTime?
  refreshMs   Int?
  error       String?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, matview, finishedAt(sort: Desc)])
  @@index([matview, startedAt(sort: Desc)])
}

// Per-(user, project) durable view preferences for the Additional Views
// feature (Phase 4). The `prefs` payload is validated by Zod on write —
// unknown keys are stripped — so the JSON column has no schema-level
// constraints. Keyed by the composite (userId, projectId) so a user has at
// most one row per project. The (projectId) secondary index backs bulk
// cleanup jobs (e.g. purge a project's preferences on project delete).
//
// Cascade on both FKs so orphan rows can't outlive their user or project.
model UserProjectViewPreference {
  userId    String
  projectId String
  prefs     Json
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([projectId])
}

// Notification (Phase 8). One row per recipient — the actor is never a
// recipient of their own action. `payload` is a compact JSON snapshot so the
// bell dropdown can render each item without a second fetch. Retention is
// 90 days, enforced by the nightly cleanup job.
model Notification {
  id              String                 @id @default(cuid())
  workspaceId     String
  recipientUserId String
  actorUserId     String?
  eventType       NotificationEventType
  sourceKind      NotificationSourceKind
  sourceId        String
  payload         Json                   @default("{}")
  readAt          DateTime?
  createdAt       DateTime               @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recipient User      @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  actor     User?     @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  // Bell dropdown reads (recent items per recipient) and unread-count query.
  @@index([recipientUserId, createdAt(sort: Desc)])
  @@index([recipientUserId, readAt])
  // Workspace-scoped audit reads and the 90-day cleanup sweep.
  @@index([workspaceId, createdAt(sort: Desc)])
}

// User preference matrix, global per user (v1 does not scope preferences by
// workspace). The composite primary key `(userId, eventType, channel)` is
// small and lookups are always by user, so no secondary index is needed
// beyond the implicit PK.
model NotificationPreference {
  userId    String
  eventType NotificationEventType
  channel   NotificationChannel
  enabled   Boolean
  updatedAt DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, eventType, channel])
}

// Browser push subscription registered per user + endpoint. `endpoint` is
// globally unique because push services issue distinct endpoints per browser
// install. `lastSeenAt` powers the dormant-subscription sweep (delete after
// 60 days without confirmed delivery).
model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  endpoint   String   @unique
  p256dh     String
  authKey    String
  userAgent  String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lastSeenAt])
}

// AI Actions (Phase 9). Workspace-level opt-in accepted by an admin before any
// AI action becomes available. `documentVersion` lets us reset consent on
// policy updates: bumping the version invalidates the acceptance until the
// admin re-accepts. One row per workspace (unique on `workspaceId`).
model WorkspaceAiConsent {
  id                String   @id @default(cuid())
  workspaceId       String   @unique
  acceptedByUserId  String
  acceptedAt        DateTime @default(now())
  documentVersion   String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  acceptedBy User      @relation("AiConsentAcceptor", fields: [acceptedByUserId], references: [id], onDelete: Restrict)
}

// AI Actions (Phase 9). Monthly rolling budget per workspace. `billingMonth`
// is `YYYY-MM` in UTC — reservations for a given calendar month land on the
// same row, which is atomically incremented via Prisma's `increment` operator
// to prevent races. `notifiedAt80` / `notifiedAt100` are set once per month
// to guarantee threshold notifications are emitted at most once per boundary.
model WorkspaceAiUsage {
  id              String    @id @default(cuid())
  workspaceId     String
  billingMonth    String
  tokensBudget    Int
  tokensReserved  Int       @default(0)
  tokensConsumed  Int       @default(0)
  notifiedAt80    DateTime?
  notifiedAt100   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, billingMonth])
  @@index([workspaceId, createdAt(sort: Desc)])
}

// AI Actions (Phase 9). One row per LLM invocation, regardless of outcome.
// `cachedInputTokens` tracks Anthropic prompt-cache hits separately from
// billable input; `latencyMs` covers the full server-side round trip
// (start → last chunk). `traceId` mirrors the propagated request trace so
// invocations correlate with logs and AuditLog rows.
model AiInvocation {
  id                String             @id @default(cuid())
  workspaceId       String
  actorUserId       String
  action            AiAction
  targetType        String?
  targetId          String?
  provider          String
  model             String
  inputTokens       Int                @default(0)
  outputTokens      Int                @default(0)
  cachedInputTokens Int                @default(0)
  latencyMs         Int                @default(0)
  status            AiInvocationStatus
  errorCode         String?
  traceId           String?
  createdAt         DateTime           @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User       @relation("AiInvocationActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  feedback  AiFeedback[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, action, createdAt(sort: Desc)])
  @@index([workspaceId, actorUserId, createdAt(sort: Desc)])
}

// AI Actions (Phase 9). Structured 👍/👎 feedback attached to a specific
// invocation. Negative feedback may include an optional free-text reason.
// One `AiInvocation` may receive at most one feedback per user (enforced by
// unique on `(invocationId, createdByUserId)`).
model AiFeedback {
  id              String           @id @default(cuid())
  workspaceId     String
  invocationId    String
  createdByUserId String
  rating          AiFeedbackRating
  reason          String?
  createdAt       DateTime         @default(now())

  workspace  Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invocation AiInvocation @relation(fields: [invocationId], references: [id], onDelete: Cascade)
  createdBy  User         @relation("AiFeedbackAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([invocationId, createdByUserId])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([invocationId])
}

// Platform (Phase 10) — Public API access key. Stored as a salted SHA-256
// digest (`keyHash` = HMAC-SHA256(keySalt, raw)); the raw value is shown to
// the creator once at creation time and never re-derivable. `keyPrefix` +
// `last4` are safe for display and secret-scanning without leaking the key.
// `scopes` is a JSON array of ApiKeyScope values (validated on write by Zod).
// `lastUsedAt` is bumped by the auth guard at most once per minute of activity.
model ApiKey {
  id              String    @id @default(cuid())
  workspaceId     String
  name            String
  keyHash         String
  keySalt         String
  keyPrefix       String
  last4           String
  scopes          Json      @default("[]")
  expiresAt       DateTime?
  revokedAt       DateTime?
  lastUsedAt      DateTime?
  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User          @relation("ApiKeyCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  usage     ApiKeyUsage[]

  // Verification path: hash lookup is scoped by prefix + last4 (short-list
  // candidates cheaply, then constant-time compare on `keyHash`).
  @@unique([keyPrefix, last4, keyHash])
  @@index([workspaceId, revokedAt])
  @@index([workspaceId, createdAt(sort: Desc)])
}

// Platform — per-minute usage rollup. Written by an async sink (never on the
// hot request path); powers the API-key usage panel and rate-limit dashboards.
// `bucketMinute` is the UTC-truncated minute (`YYYY-MM-DDTHH:MM:00Z`) so
// aggregation is a simple GROUP BY on a string.
model ApiKeyUsage {
  id                String @id @default(cuid())
  apiKeyId          String
  bucketMinute      String
  requestCount      Int    @default(0)
  rateLimitedCount  Int    @default(0)

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@unique([apiKeyId, bucketMinute])
  @@index([apiKeyId, bucketMinute(sort: Desc)])
}

// Platform — outbound webhook subscription. `secretHash` + `secretSalt` are
// stored the same way as ApiKey — the raw secret is shown once at create and
// again once after rotate-secret, then never returned. `eventTypes` is a
// String[] of WebhookEventType values (Postgres native array).
model Webhook {
  id               String    @id @default(cuid())
  workspaceId      String
  url              String
  eventTypes       String[]
  secretHash       String
  secretSalt       String
  secretRotatedAt  DateTime?
  isActive         Boolean   @default(true)
  createdByUserId  String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace     Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy     User                   @relation("WebhookCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  deliveries    WebhookDelivery[]
  dlqDeliveries WebhookDeliveryDLQ[]

  @@index([workspaceId, isActive])
  @@index([workspaceId, createdAt(sort: Desc)])
}

// Platform — one row per delivery attempt (BullMQ retry included). Retention:
// 30 days, swept by the existing CleanupProcessor with a new job type.
// `eventId` is the idempotency key echoed to the receiver so they can dedupe
// retries. `responseSnippet` is truncated to the first ~1KB of the body.
model WebhookDelivery {
  id              String    @id @default(cuid())
  webhookId       String
  eventType       String
  eventId         String
  attempt         Int       @default(1)
  statusCode      Int?
  responseSnippet String?
  error           String?
  enqueuedAt      DateTime  @default(now())
  deliveredAt     DateTime?
  failedAt        DateTime?

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, enqueuedAt(sort: Desc)])
  @@index([webhookId, eventId])
  @@index([enqueuedAt])
}

// Platform — dead-letter queue. Populated when a delivery exhausts its retry
// budget (24 h ceiling). `payload` is the exact JSON body that was going to be
// POSTed, so a manual replay can rebuild the request byte-for-byte. Retention:
// 30 days, swept alongside WebhookDelivery.
model WebhookDeliveryDLQ {
  id             String   @id @default(cuid())
  webhookId      String
  eventType      String
  eventId        String
  payload        Json
  lastAttemptAt  DateTime
  retryCount     Int
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt(sort: Desc)])
  @@index([expiresAt])
}

// Platform — one row per (workspace, provider). References the existing
// OAuthAccount row so the OAuth adapter continues to own token refresh and
// scope grants; `config` carries integration-specific settings (selected
// repositories, target calendar id, etc.). `state` distinguishes CONNECTED
// from NEEDS_RECONNECT so the UI can render the *Reconnect* CTA without
// re-inspecting the underlying token.
model Integration {
  id              String              @id @default(cuid())
  workspaceId     String
  provider        IntegrationProvider
  oauthAccountId  String
  config          Json                @default("{}")
  state           IntegrationState    @default(CONNECTED)
  createdByUserId String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  oauthAccount OAuthAccount @relation(fields: [oauthAccountId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("IntegrationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, provider])
  @@index([workspaceId, state])
}

// Platform (GitHub) — bidirectional link from a Tasker task to an external
// issue or pull request. `externalRef` is the canonical `owner/repo#n` form;
// the unique on (taskId, provider, externalRef) blocks duplicate links from
// either direction (Tasker → GitHub or GitHub webhook → Tasker).
model TaskExternalLink {
  id           String               @id @default(cuid())
  workspaceId  String
  taskId       String
  provider     IntegrationProvider
  externalType TaskExternalLinkType
  externalRef  String
  externalUrl  String
  createdAt    DateTime             @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, provider, externalRef])
  @@index([workspaceId, provider])
  @@index([taskId])
}
