generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

enum OAuthProvider {
  GOOGLE
  GITHUB
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum AttachmentStatus {
  PENDING
  READY
  DELETING
}

enum SprintState {
  PLANNED
  ACTIVE
  COMPLETED
}

enum SprintSnapshotPhase {
  START
  COMPLETE
}

enum EpicStatus {
  PLANNED
  IN_PROGRESS
  DONE
  CANCELED
}

enum MetricJobStatus {
  RUNNING
  OK
  FAILED
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique @db.Citext
  emailVerifiedAt DateTime?
  passwordHash    String?
  displayName     String
  avatarUrl       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  oauthAccounts           OAuthAccount[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  sessions                Session[]
  workspaceMembers        WorkspaceMember[]
  ownedWorkspaces         Workspace[]                 @relation("WorkspaceOwner")
  sentInvitations         Invitation[]                @relation("InvitationSender")
  auditLogs               AuditLog[]                  @relation("AuditLogActor")
  ownedProjects           Project[]                   @relation("ProjectOwner")
  createdProjects         Project[]                   @relation("ProjectCreator")
  assignedTasks           Task[]                      @relation("TaskAssignee")
  createdTasks            Task[]                      @relation("TaskCreator")
  comments                Comment[]
  viewPreferences         UserProjectViewPreference[]
  commentMentions         CommentMention[]            @relation("MentionedUser")
  commentReactions        CommentReaction[]           @relation("CommentReactor")
  uploadedAttachments     Attachment[]                @relation("AttachmentUploader")
  activities              Activity[]                  @relation("ActivityActor")
  createdSprints          Sprint[]                    @relation("SprintCreator")
  sprintCapacities        SprintCapacity[]            @relation("SprintCapacityMember")
  createdEpics            Epic[]                      @relation("EpicCreator")
}

model OAuthAccount {
  id                String        @id @default(cuid())
  userId            String
  provider          OAuthProvider
  providerAccountId String
  createdAt         DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Workspace {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  ownerUserId String
  deletedAt   DateTime?
  purgeAt     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner            User              @relation("WorkspaceOwner", fields: [ownerUserId], references: [id])
  members          WorkspaceMember[]
  invitations      Invitation[]
  auditLogs        AuditLog[]
  projects         Project[]
  labels           Label[]
  tasks            Task[]
  comments         Comment[]
  commentMentions  CommentMention[]
  commentReactions CommentReaction[]
  attachments      Attachment[]
  activities       Activity[]
  sprints          Sprint[]
  sprintCapacities SprintCapacity[]
  sprintSnapshots  SprintTaskSnapshot[]
  epics            Epic[]
  metricJobLogs    MetricJobLog[]
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole
  joinedAt    DateTime      @default(now())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Invitation {
  id              String        @id @default(cuid())
  workspaceId     String
  email           String        @db.Citext
  role            WorkspaceRole
  tokenHash       String        @unique
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitationSender", fields: [invitedByUserId], references: [id])
}

model Session {
  id          String    @id @default(cuid())
  userId      String
  refreshHash String    @unique
  deviceLabel String
  userAgent   String?
  ip          String?
  lastUsedAt  DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String?
  actorUserId String?
  event       String
  targetType  String?
  targetId    String?
  metadata    Json     @default("{}")
  traceId     String?
  createdAt   DateTime @default(now())

  // SetNull on workspace so hard-deleting a workspace (cleanup cron past
  // purgeAt) preserves the audit trail — the FK falls back to null instead
  // of blocking the delete or cascading it away.
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  actor     User?      @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, targetType, createdAt(sort: Desc)])
  @@index([event])
}

model Project {
  id              String        @id @default(cuid())
  workspaceId     String
  slug            String
  name            String
  description     String?
  color           String
  icon            String
  status          ProjectStatus @default(ACTIVE)
  ownerUserId     String
  createdByUserId String
  deletedAt       DateTime?
  purgeAt         DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  workspace       Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner           User                        @relation("ProjectOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  createdBy       User                        @relation("ProjectCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  tasks           Task[]
  sequence        ProjectSequence?
  viewPreferences UserProjectViewPreference[]
  activities      Activity[]
  sprints         Sprint[]
  epics           Epic[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, status])
}

model Label {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  color       String
  createdAt   DateTime @default(now())

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  taskLinks TaskLabel[]

  @@unique([workspaceId, name])
}

model Task {
  id              String     @id @default(cuid())
  workspaceId     String
  projectId       String
  number          Int
  title           String
  description     String     @default("")
  status          TaskStatus @default(BACKLOG)
  priority        Priority   @default(MEDIUM)
  position        String
  assigneeUserId  String?
  createdByUserId String
  startDate       DateTime?
  dueDate         DateTime?
  // Planning (Phase 6) — nullable so pre-existing tasks are unaffected.
  // `estimate` in story points contributes to burndown/velocity; null counts
  // as 0 for point sums but still counts for scope.
  estimate  Int?
  sprintId  String?
  epicId    String?
  deletedAt DateTime?
  purgeAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  workspace      Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project        Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee       User?                 @relation("TaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  createdBy      User                  @relation("TaskCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  sprint         Sprint?               @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  epic           Epic?                 @relation(fields: [epicId], references: [id], onDelete: SetNull)
  labels         TaskLabel[]
  dependencies   TaskDependency[]      @relation("TaskDependencies_task")
  dependents     TaskDependency[]      @relation("TaskDependencies_blocker")
  checklistItems ChecklistItem[]
  comments       Comment[]
  attachments    Attachment[]
  activities     Activity[]
  sprintSnapshots SprintTaskSnapshot[]

  @@unique([projectId, number])
  @@index([workspaceId, projectId, status, position])
  @@index([workspaceId, assigneeUserId, status])
  @@index([workspaceId, projectId, startDate, dueDate])
  @@index([sprintId])
  @@index([sprintId, status])
  @@index([epicId])
}

model TaskLabel {
  taskId  String
  labelId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
}

model TaskDependency {
  taskId          String
  blockedByTaskId String

  task      Task @relation("TaskDependencies_task", fields: [taskId], references: [id], onDelete: Cascade)
  blockedBy Task @relation("TaskDependencies_blocker", fields: [blockedByTaskId], references: [id], onDelete: Cascade)

  @@id([taskId, blockedByTaskId])
  @@index([blockedByTaskId])
}

model ChecklistItem {
  id        String   @id @default(cuid())
  taskId    String
  title     String
  checked   Boolean  @default(false)
  position  String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, position])
}

model Comment {
  id           String    @id @default(cuid())
  workspaceId  String
  taskId       String
  authorUserId String
  body         String
  editedAt     DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User              @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  mentions  CommentMention[]
  reactions CommentReaction[]

  @@index([taskId, createdAt])
}

// One row per (comment, mentioned user). Persisting by userId (not handle)
// makes mentions survive display-name renames and lets removed members fail
// closed at render time (mention resolves to plain text). Offset is the byte
// offset in the comment body of the '@' character, kept so the client can
// re-derive positions without re-parsing.
model CommentMention {
  id              String   @id @default(cuid())
  workspaceId     String
  commentId       String
  mentionedUserId String
  offset          Int
  createdAt       DateTime @default(now())

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  comment       Comment   @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUser User      @relation("MentionedUser", fields: [mentionedUserId], references: [id], onDelete: Cascade)

  @@unique([commentId, mentionedUserId])
  @@index([mentionedUserId, createdAt(sort: Desc)])
  @@index([workspaceId])
}

// Idempotent add/remove — the unique triple (comment, user, emoji) blocks
// duplicates so a second POST is a no-op. Emoji is validated in application
// code against the shared ReactionsCatalog; storing as a plain string keeps
// the catalog governance out of the DB layer.
model CommentReaction {
  id          String   @id @default(cuid())
  workspaceId String
  commentId   String
  userId      String
  emoji       String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  comment   Comment   @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User      @relation("CommentReactor", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
  @@index([commentId, emoji])
  @@index([workspaceId])
}

// Attachment metadata; the bytes themselves live in object storage. Status
// tracks the two-phase upload: PENDING after signUpload(), READY after
// confirm(), DELETING while the janitor sweeps object-storage residue.
model Attachment {
  id             String           @id @default(cuid())
  workspaceId    String
  taskId         String
  uploaderUserId String
  storageKey     String           @unique
  filename       String
  mime           String
  sizeBytes      Int
  status         AttachmentStatus @default(PENDING)
  deletedAt      DateTime?
  createdAt      DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader  User      @relation("AttachmentUploader", fields: [uploaderUserId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([workspaceId])
}

// Product-facing activity feed. Distinct from AuditLog: AuditLog is retained
// for compliance and is written for every server-side write, while Activity
// carries denormalized payload snapshots and is optimized for feed reads.
// payload is a compact JSON snapshot so the feed can render a line without
// a second fetch (see techspec § Data flow).
model Activity {
  id          String   @id @default(cuid())
  workspaceId String
  projectId   String
  taskId      String?
  actorUserId String?
  verb        String
  payload     Json     @default("{}")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor     User?     @relation("ActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([taskId, createdAt(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc)])
}

model ProjectSequence {
  projectId  String @id
  nextNumber Int    @default(1)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// Planning — Sprint lifecycle. Number is auto-generated per project (unique
// (projectId, number)). PRD FR-2 caps one Active sprint per project; that
// invariant is enforced by a partial unique index in the accompanying SQL
// migration (Prisma cannot express `WHERE state='ACTIVE'` in `@@unique`).
model Sprint {
  id              String      @id @default(cuid())
  workspaceId     String
  projectId       String
  number          Int
  name            String
  goal            String?
  state           SprintState @default(PLANNED)
  startDate       DateTime
  endDate         DateTime
  startedAt       DateTime?
  completedAt     DateTime?
  createdByUserId String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  workspace  Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project    Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User                 @relation("SprintCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  tasks      Task[]
  snapshots  SprintTaskSnapshot[]
  capacities SprintCapacity[]

  @@unique([projectId, number])
  @@index([workspaceId, state])
  @@index([workspaceId, projectId, startDate])
}

// Planning — optional per-member capacity for planner over-allocation warning.
// Scoped strictly to the sprint (does not persist across sprints unless the
// planner explicitly copies it forward — see FR-15).
model SprintCapacity {
  id              String   @id @default(cuid())
  workspaceId     String
  sprintId        String
  memberUserId    String
  capacityPoints  Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sprint    Sprint    @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  member    User      @relation("SprintCapacityMember", fields: [memberUserId], references: [id], onDelete: Cascade)

  @@unique([sprintId, memberUserId])
  @@index([workspaceId])
}

// Planning — immutable snapshot of a task at a sprint lifecycle boundary
// (START on activate, COMPLETE on close). Powers burndown and the close
// summary so editing the underlying Task does not drift historical metrics.
model SprintTaskSnapshot {
  id              String              @id @default(cuid())
  workspaceId     String
  sprintId        String
  taskId          String
  phase           SprintSnapshotPhase
  snapshotAt      DateTime            @default(now())
  status          TaskStatus
  estimate        Int?
  assigneeUserId  String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sprint    Sprint    @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([sprintId, taskId, phase])
  @@index([sprintId, phase, snapshotAt])
  @@index([workspaceId])
}

// Planning — quarterly roadmap epic. `startQuarter`/`endQuarter` are the
// canonical `YYYY-Qn` id (see packages/config → QUARTER_ID_REGEXP). Soft
// delete leaves linked tasks intact — unlinking is not the same as archiving.
model Epic {
  id              String     @id @default(cuid())
  workspaceId     String
  projectId       String
  title           String
  description     String?
  status          EpicStatus @default(PLANNED)
  startQuarter    String
  endQuarter      String
  createdByUserId String
  deletedAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User      @relation("EpicCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  tasks     Task[]

  @@index([workspaceId, startQuarter, endQuarter])
  @@index([workspaceId, projectId, status])
}

// Planning — metrics job telemetry. Powers the dashboard `asOf` timestamp
// (last successful matview refresh) and the /health probe for the metrics
// worker. `workspaceId` nullable because the repeatable job runs globally.
model MetricJobLog {
  id           String          @id @default(cuid())
  workspaceId  String?
  matview      String
  status       MetricJobStatus
  startedAt    DateTime        @default(now())
  finishedAt   DateTime?
  refreshMs    Int?
  error        String?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, matview, finishedAt(sort: Desc)])
  @@index([matview, startedAt(sort: Desc)])
}

// Per-(user, project) durable view preferences for the Additional Views
// feature (Phase 4). The `prefs` payload is validated by Zod on write —
// unknown keys are stripped — so the JSON column has no schema-level
// constraints. Keyed by the composite (userId, projectId) so a user has at
// most one row per project. The (projectId) secondary index backs bulk
// cleanup jobs (e.g. purge a project's preferences on project delete).
//
// Cascade on both FKs so orphan rows can't outlive their user or project.
model UserProjectViewPreference {
  userId    String
  projectId String
  prefs     Json
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([projectId])
}
