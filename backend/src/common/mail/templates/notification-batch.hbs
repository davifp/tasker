<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>You have new notifications</title>
  <style>
    body { font-family: sans-serif; background: #f4f4f5; margin: 0; padding: 24px; }
    .card { background: #fff; border-radius: 8px; max-width: 560px; margin: 0 auto; padding: 40px; }
    h1 { font-size: 24px; margin: 0 0 16px; color: #111827; }
    ul { list-style: none; padding: 0; margin: 0 0 24px; }
    li { padding: 12px 0; border-bottom: 1px solid #e5e7eb; }
    li:last-child { border-bottom: none; }
    a { color: #6366f1; text-decoration: none; }
    .footer { font-size: 12px; color: #9ca3af; margin-top: 32px; }
  </style>
</head>
<body>
  <div class="card">
    <h1>{{count}} new notifications on Tasker</h1>
    <ul>
      {{#each items}}
        <li>
          <a href="{{this.sourceUrl}}"><strong>{{this.actorName}}</strong> {{this.summary}}</a>
        </li>
      {{/each}}
    </ul>
    <p class="footer">You can adjust your notification preferences at {{preferencesUrl}}.</p>
  </div>
</body>
</html>
