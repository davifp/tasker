<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>New comment</title>
  <style>
    body { font-family: sans-serif; background: #f4f4f5; margin: 0; padding: 24px; }
    .card { background: #fff; border-radius: 8px; max-width: 480px; margin: 0 auto; padding: 40px; }
    h1 { font-size: 24px; margin: 0 0 16px; color: #111827; }
    p { font-size: 15px; color: #374151; line-height: 1.6; margin: 0 0 24px; }
    blockquote { border-left: 3px solid #6366f1; padding: 8px 16px; color: #4b5563; background: #f9fafb; margin: 0 0 24px; }
    .btn { display: inline-block; background: #6366f1; color: #fff; text-decoration: none; padding: 12px 24px; border-radius: 6px; font-size: 15px; font-weight: 600; }
    .footer { font-size: 12px; color: #9ca3af; margin-top: 32px; }
  </style>
</head>
<body>
  <div class="card">
    <h1>New comment on {{taskTitle}}</h1>
    <p>{{actorName}} commented in {{projectName}}.</p>
    <blockquote>{{excerpt}}</blockquote>
    <a class="btn" href="{{sourceUrl}}">Open the discussion</a>
    <p class="footer">You are receiving this because you follow this task. Update at {{preferencesUrl}}.</p>
  </div>
</body>
</html>
