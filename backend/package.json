{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc --project tsconfig.build.json && node -e \"require('fs').cpSync('src/common/mail/templates','dist/common/mail/templates',{recursive:true})\"",
    "build:worker": "tsc --project tsconfig.build.json && node -e \"require('fs').cpSync('src/common/mail/templates','dist/common/mail/templates',{recursive:true})\"",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "openapi:dump": "ts-node-dev --transpile-only --respawn=false scripts/dump-openapi.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@aws-sdk/client-s3": "^3.1093.0",
    "@aws-sdk/s3-request-presigner": "^3.1093.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/swagger": "^11.2.7",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.28",
    "@prisma/client": "^6.0.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@tasker/config": "workspace:*",
    "argon2": "^0.44.0",
    "bullmq": "^5.80.4",
    "dotenv": "^16.0.0",
    "fractional-indexing": "^3.2.0",
    "handlebars": "^4.7.9",
    "ioredis": "^5.4.0",
    "nestjs-cls": "^6.2.1",
    "nestjs-pino": "^4.1.0",
    "nestjs-zod": "^4.2.0",
    "nodemailer": "^9.0.3",
    "openai": "^7.0.0",
    "passport": "^0.7.0",
    "passport-custom": "^1.2.1",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "pino-pretty": "^13.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@swc/core": "^1.15.43",
    "@tasker/eslint-config": "workspace:*",
    "@tasker/tsconfig": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "prisma": "^6.0.0",
    "testcontainers": "^10.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.0",
    "unplugin-swc": "^1.5.9",
    "vite-tsconfig-paths": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
